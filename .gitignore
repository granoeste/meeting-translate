.venv/
__pycache__/
*.pyc
.DS_Store

# 会議の全文が平文で残るので、絶対にコミットしない
transcripts/

# 社内のパッケージプロキシの URL が入るため含めない(uv sync で作られる)
uv.lock

# 各自の設定(見本は config.example.toml)
config.toml

# 使うプラグインの一覧(各自の設定。見本は plugins.example.toml)
plugins.toml
# プラグインごとの設定。Webhook の URL など秘密の値が入る(見本は plugins/<名前>.example.toml)
# 秘密の値の無い web.toml だけはコミットする
plugins/*.toml
!plugins/*.example.toml
!plugins/web.toml

# 中継(relay/)を wrangler で動かしたときにできるもの。.dev.vars には手元で試すときの閲覧キーと送信トークンが入る
relay/.wrangler/
relay/.dev.vars
relay/node_modules/
